[{"id": "2037415024717930743", "author_id": "1448583889505579008", "edit_history_tweet_ids": ["2037415024717930743"], "conversation_id": "2037398838294802452", "public_metrics": {"retweet_count": 0, "reply_count": 0, "like_count": 1, "quote_count": 0, "bookmark_count": 0, "impression_count": 16}, "created_at": "2026-03-27T06:22:49.000Z", "entities": {"mentions": [{"start": 0, "end": 14, "username": "ChinaWhaleETH", "id": "1387297550588284929"}]}, "text": "@ChinaWhaleETH 欧易少用吧，钱包被盗，交易所恶意插针，同样的仓位，币安都没爆，他硬给我插没了", "collected_at": "2026-03-27T15:00:33.967052"}, {"id": "2037402301531619337", "author_id": "1844585956982259712", "edit_history_tweet_ids": ["2037402301531619337"], "conversation_id": "2037402301531619337", "entities": {"urls": [{"start": 122, "end": 145, "url": "https://t.co/Gc8lWhD1U8", "expanded_url": "https://jinbiannews.com/archives/8374", "display_url": "jinbiannews.com/archives/8374", "images": [{"url": "https://pbs.twimg.com/news_img/2037397827484327936/S_-lICWK?format=jpg&name=orig", "width": 1020, "height": 574}, {"url": "https://pbs.twimg.com/news_img/2037397827484327936/S_-lICWK?format=jpg&name=150x150", "width": 150, "height": 150}], "status": 200, "title": "柬埔寨8号园区和新币担保被英国政府制裁 – 金边现场", "description": "3月26日，英国政府宣布对柬埔寨目前最大的诈骗园区8号园区和东南亚目前最大的非法加密货币交易平台之一“新币担保”进行制裁。 英国政府3月26日 宣布 对持有8号园区的公司“传奇创新”公司（Legend Innovation）及其董事长 Eang Soklim（柬埔寨人）进行制裁。 2025年7月，日本媒体 曾报道 8号园区内宿舍、超市、夜总会一应俱全，当地司机称：“每个人都知道这里是诈骗窝点”。 去年底汇旺遭遇挤兑危机时，8号园区物业曾发布通知要求必须使用汇旺，如有园区内商家拒收汇旺，“一经发现停业整顿，态度恶劣，拒不配合者直接清退。” 英国政府称，此次制裁将使该平台与合法的加密生态系统隔离，通过限制其收发加密货币交易的能力，严重扰乱其运作。此前，另一个被用于清洗诈骗所得的加密货币平台“BYEX”已在去年英国制裁后关闭。 英国政府还对被称为太子集团“幕后老板”的胡小伟等太子集团重要人物", "unwound_url": "https://jinbiannews.com/archives/8374"}, {"start": 146, "end": 169, "url": "https://t.co/nDXZg0zpMc", "expanded_url": "https://x.com/pponthegrounds/status/2037402301531619337/photo/1", "display_url": "pic.x.com/nDXZg0zpMc", "media_key": "3_2037402289598836736"}]}, "public_metrics": {"retweet_count": 0, "reply_count": 1, "like_count": 0, "quote_count": 0, "bookmark_count": 0, "impression_count": 55}, "created_at": "2026-03-27T05:32:16.000Z", "text": "【新币担保被英国政府制裁】\n\n英国政府还宣布对新币担保进行制裁。该平台是东南亚最大的非法交易市场之一，为包括8号园区在内的诈骗园区提供基于加密货币的服务。\n\n这些服务包括出售被盗取的个人数据，以及提供用于联系受害者的卫星互联网设备。\n详情点击：https://t.co/Gc8lWhD1U8 https://t.co/nDXZg0zpMc", "collected_at": "2026-03-27T15:00:33.967060"}, {"id": "2037358730812232103", "author_id": "1536221575401582592", "edit_history_tweet_ids": ["2037358730812232103"], "conversation_id": "2037358730812232103", "public_metrics": {"retweet_count": 0, "reply_count": 0, "like_count": 2, "quote_count": 0, "bookmark_count": 0, "impression_count": 31}, "created_at": "2026-03-27T02:39:08.000Z", "text": "是不是tm有内幕啊操，前两天扫链，还看到这破币有异动，当时还想都tm多久的币了，一点没买……，下次记得买点吧，感觉tm一些官方账号是不是被盗号了?还是太巧合了?", "collected_at": "2026-03-27T15:00:33.967066"}, {"id": "2037319458168144301", "author_id": "1886510677855993856", "edit_history_tweet_ids": ["2037319458168144301"], "conversation_id": "2037319458168144301", "entities": {"urls": [{"start": 96, "end": 119, "url": "https://t.co/B18hSO1rkB", "expanded_url": "https://x.com/JWick92065/status/2037319458168144301/photo/1", "display_url": "pic.x.com/B18hSO1rkB", "media_key": "3_2037319441491673088"}, {"start": 96, "end": 119, "url": "https://t.co/B18hSO1rkB", "expanded_url": "https://x.com/JWick92065/status/2037319458168144301/photo/1", "display_url": "pic.x.com/B18hSO1rkB", "media_key": "3_2037319441420308480"}]}, "public_metrics": {"retweet_count": 0, "reply_count": 6, "like_count": 14, "quote_count": 2, "bookmark_count": 0, "impression_count": 463}, "created_at": "2026-03-27T00:03:05.000Z", "text": "【我也悬赏】2020年钱包被盗，帽子叔叔当时就立案了，一直没结果，现在情况情况不明朗也没去联系。钱包的地址能查到，币还在，有大神能帮我找回的，至少五成，剩下的给所有帮我转发的发红包，有贴为证 https://t.co/B18hSO1rkB", "collected_at": "2026-03-27T15:00:33.967072"}, {"id": "2037285565327188405", "author_id": "2001080509485748224", "edit_history_tweet_ids": ["2037285565327188405"], "conversation_id": "2037080829994950942", "public_metrics": {"retweet_count": 0, "reply_count